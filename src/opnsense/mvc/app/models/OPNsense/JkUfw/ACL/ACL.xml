<acl>
    <!-- jk-ufw pages; the APIs they call keep their own ACLs -->
    <page-jkufw-devices>
        <name>Lobby: Devices</name>
        <patterns>
            <pattern>ui/jkufw/devices</pattern>
        </patterns>
    </page-jkufw-devices>
    <!-- jk-ufw additions, kept in their own file so upstream ACL changes merge cleanly -->
    <page-firewall-geoblock>
        <name>Firewall: Country Blocking</name>
        <description>Block countries on a world map (manages the jkufw_geoblock GeoIP alias and its two rules)</description>
        <patterns>
            <pattern>ui/firewall/geoblock/*</pattern>
            <pattern>api/firewall/alias/*</pattern>
            <pattern>api/firewall/filter/*</pattern>
            <pattern>api/diagnostics/firewall/log</pattern>
        </patterns>
    </page-firewall-geoblock>
    <!-- jk-ufw additions -->
    <page-jkufw-parental>
        <name>Firewall: Content Filter and Parental Control</name>
        <patterns>
            <pattern>ui/jkufw/parental</pattern>
            <pattern>api/jkufw/parental/*</pattern>
        </patterns>
    </page-jkufw-parental>
    <!-- jk-ufw additions -->
    <page-jkufw-notify>
        <name>System: Settings: Notifications (Telegram)</name>
        <patterns>
            <pattern>ui/jkufw/notify</pattern>
            <pattern>api/jkufw/notify/*</pattern>
        </patterns>
    </page-jkufw-notify>
    <!-- jk-ufw additions -->
    <page-jkufw-waf>
        <name>Firewall: Web Protection (WAF)</name>
        <description>Protected websites behind the nginx plugin with NAXSI; installs os-nginx and reconfigures it</description>
        <patterns>
            <pattern>ui/jkufw/waf</pattern>
            <pattern>api/jkufw/waf/*</pattern>
            <pattern>api/nginx/service/reconfigure</pattern>
            <pattern>api/core/firmware/install/os-nginx</pattern>
            <pattern>api/core/firmware/upgradestatus</pattern>
        </patterns>
    </page-jkufw-waf>
    <!-- jk-ufw additions -->
    <page-jkufw-mail>
        <name>Services: Mail Protection</name>
        <description>Mail gateway: Postfix relay, rspamd antispam, ClamAV antivirus, Redis greylisting</description>
        <patterns>
            <pattern>ui/jkufw/mail</pattern>
            <pattern>api/jkufw/mail/*</pattern>
            <pattern>api/postfix/service/reconfigure</pattern>
            <pattern>api/rspamd/service/reconfigure</pattern>
            <pattern>api/clamav/service/reconfigure</pattern>
            <pattern>api/clamav/service/freshclam</pattern>
            <pattern>api/redis/service/reconfigure</pattern>
            <pattern>api/core/firmware/install/os-postfix</pattern>
            <pattern>api/core/firmware/install/os-rspamd</pattern>
            <pattern>api/core/firmware/install/os-clamav</pattern>
            <pattern>api/core/firmware/install/os-redis</pattern>
            <pattern>api/core/firmware/upgradestatus</pattern>
        </patterns>
    </page-jkufw-mail>
</acl>
