<acl>
    <!-- jk-ufw pages; the APIs they call keep their own ACLs -->
    <page-jkufw-devices>
        <name>Lobby: Devices</name>
        <patterns>
            <pattern>ui/jkufw/devices</pattern>
        </patterns>
    </page-jkufw-devices>
    <page-jkufw-topology>
        <name>Lobby: Topology</name>
        <patterns>
            <pattern>ui/jkufw/topology</pattern>
        </patterns>
    </page-jkufw-topology>
    <!-- jk-ufw additions, kept in their own file so upstream ACL changes merge cleanly -->
    <page-firewall-geoblock>
        <name>Firewall: Country Blocking</name>
        <description>Block countries on a world map (manages the jkufw_geoblock GeoIP alias and its two rules)</description>
        <patterns>
            <pattern>ui/firewall/geoblock/*</pattern>
            <pattern>api/firewall/alias/*</pattern>
            <pattern>api/firewall/filter/*</pattern>
            <pattern>api/diagnostics/firewall/log</pattern>
        </patterns>
    </page-firewall-geoblock>
    <!-- jk-ufw additions -->
    <page-jkufw-parental>
        <name>Firewall: Content Filter and Parental Control</name>
        <patterns>
            <pattern>ui/jkufw/parental</pattern>
            <pattern>api/jkufw/parental/*</pattern>
        </patterns>
    </page-jkufw-parental>
    <!-- jk-ufw additions -->
    <page-jkufw-notify>
        <name>System: Settings: Notifications (Telegram)</name>
        <patterns>
            <pattern>ui/jkufw/notify</pattern>
            <pattern>api/jkufw/notify/*</pattern>
        </patterns>
    </page-jkufw-notify>
</acl>
