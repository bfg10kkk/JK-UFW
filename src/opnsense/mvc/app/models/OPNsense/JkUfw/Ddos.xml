<model>
    <mount>//OPNsense/JkUfw/ddos</mount>
    <version>1.0.0</version>
    <description>jk-ufw attack protection: DDoS limits, threat intelligence (IoC) block lists, log export to a SIEM</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <!-- level picked on the page; only fills the fields below, the fields are what is applied -->
            <preset type="OptionField">
                <Required>Y</Required>
                <Default>standard</Default>
                <OptionValues>
                    <light>Light</light>
                    <standard>Standard</standard>
                    <strict>Strict</strict>
                    <custom>Custom</custom>
                </OptionValues>
            </preset>
            <!-- pf SYN cookies: answer SYN floods without filling the state table -->
            <syncookies type="OptionField">
                <Required>Y</Required>
                <Default>adaptive</Default>
                <OptionValues>
                    <off>Off</off>
                    <adaptive>When the state table fills up</adaptive>
                    <always>Always</always>
                </OptionValues>
            </syncookies>
            <!-- shorten idle timeouts as the state table fills up (pf adaptive timeouts, 60 % .. 120 % of the limit) -->
            <adaptive type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </adaptive>
            <!-- pf optimization profile; aggressive drops idle connections sooner -->
            <optimization type="OptionField">
                <Required>Y</Required>
                <Default>normal</Default>
                <OptionValues>
                    <normal>Normal</normal>
                    <aggressive>Aggressive</aggressive>
                    <conservative>Conservative</conservative>
                </OptionValues>
            </optimization>
            <!-- answers the firewall itself sends (ICMP errors, TCP resets) per second; 0 = no limit -->
            <icmplimit type="IntegerField">
                <Default>500</Default>
                <Required>Y</Required>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>100000</MaximumValue>
                <ValidationMessage>0 to 100000 answers per second.</ValidationMessage>
            </icmplimit>
            <!-- block reserved (never assigned) address ranges on the protected interfaces -->
            <bogons type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </bogons>
            <!-- minutes an address stays blocked after crossing a limit -->
            <blocktime type="IntegerField">
                <Default>60</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>10080</MaximumValue>
                <ValidationMessage>1 minute to 7 days (10080 minutes).</ValidationMessage>
            </blocktime>
            <!-- never blocked automatically -->
            <allow type="CSVListField">
                <Mask>/^[0-9a-fA-F:.]+(\/[0-9]{1,3})?$/</Mask>
                <MaskPerItem>Y</MaskPerItem>
                <ValidationMessage>Enter IP addresses or networks, e.g. 203.0.113.7, 198.51.100.0/24.</ValidationMessage>
            </allow>
            <!-- always blocked on the protected interfaces -->
            <deny type="CSVListField">
                <Mask>/^[0-9a-fA-F:.]+(\/[0-9]{1,3})?$/</Mask>
                <MaskPerItem>Y</MaskPerItem>
                <ValidationMessage>Enter IP addresses or networks, e.g. 203.0.113.7, 198.51.100.0/24.</ValidationMessage>
            </deny>
        </general>
        <interfaces>
            <!-- per protected (internet facing) interface: limits put on its pass rules that are open to everyone -->
            <interface type="ArrayField">
                <interface type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[a-z0-9_]{1,32}$/</Mask>
                </interface>
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <level type="OptionField">
                    <Required>Y</Required>
                    <Default>standard</Default>
                    <OptionValues>
                        <light>Light</light>
                        <standard>Standard</standard>
                        <strict>Strict</strict>
                        <custom>Custom</custom>
                    </OptionValues>
                </level>
                <!-- open connections (states) one address may hold -->
                <states type="IntegerField">
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>1000000</MaximumValue>
                    <ValidationMessage>1 to 1000000.</ValidationMessage>
                </states>
                <!-- fully opened TCP connections one address may hold -->
                <conns type="IntegerField">
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>1000000</MaximumValue>
                    <ValidationMessage>1 to 1000000.</ValidationMessage>
                </conns>
                <!-- new TCP connections per "per" seconds before the address goes to the block list -->
                <rate type="IntegerField">
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>100000</MaximumValue>
                    <ValidationMessage>1 to 100000.</ValidationMessage>
                </rate>
                <per type="IntegerField">
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>3600</MaximumValue>
                    <ValidationMessage>1 to 3600 seconds.</ValidationMessage>
                </per>
                <!-- the firewall completes the TCP handshake itself before passing it on -->
                <synproxy type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </synproxy>
            </interface>
        </interfaces>
        <ioc>
            <!-- threat intelligence feeds: lists of known bad addresses, downloaded on a schedule -->
            <feed type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[^\r\n,]{1,48}$/u</Mask>
                    <ValidationMessage>Name should be 1 to 48 characters, without commas.</ValidationMessage>
                </name>
                <url type="UrlField">
                    <Required>Y</Required>
                </url>
                <!-- hours between downloads -->
                <refresh type="IntegerField">
                    <Default>12</Default>
                    <Required>Y</Required>
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>168</MaximumValue>
                    <ValidationMessage>1 to 168 hours.</ValidationMessage>
                </refresh>
            </feed>
            <!-- own indicators: addresses and networks pasted on the page -->
            <custom type="CSVListField">
                <Mask>/^[0-9a-fA-F:.]+(\/[0-9]{1,3})?$/</Mask>
                <MaskPerItem>Y</MaskPerItem>
                <ValidationMessage>Enter IP addresses or networks, one per line.</ValidationMessage>
            </custom>
            <log type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </log>
        </ioc>
        <siem>
            <!-- copies of the logs sent to a SIEM / log collector -->
            <target type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <name type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[^\r\n,"]{1,48}$/u</Mask>
                    <ValidationMessage>Name should be 1 to 48 characters, without commas or quotes.</ValidationMessage>
                </name>
                <host type="HostnameField">
                    <Required>Y</Required>
                    <IpAllowed>Y</IpAllowed>
                </host>
                <port type="PortField">
                    <Required>Y</Required>
                    <Default>514</Default>
                </port>
                <transport type="OptionField">
                    <Required>Y</Required>
                    <Default>udp4</Default>
                    <OptionValues>
                        <udp4>UDP (IPv4)</udp4>
                        <tcp4>TCP (IPv4)</tcp4>
                        <udp6>UDP (IPv6)</udp6>
                        <tcp6>TCP (IPv6)</tcp6>
                    </OptionValues>
                </transport>
                <format type="OptionField">
                    <Required>Y</Required>
                    <Default>cef</Default>
                    <OptionValues>
                        <cef>CEF (ArcSight, QRadar, MaxPatrol, KUMA)</cef>
                        <json>JSON (Elastic, Graylog, Wazuh)</json>
                        <rfc5424>Syslog RFC 5424</rfc5424>
                    </OptionValues>
                </format>
                <logs type="OptionField">
                    <Required>Y</Required>
                    <Multiple>Y</Multiple>
                    <Default>firewall,ids,security,auth</Default>
                    <OptionValues>
                        <firewall>Firewall</firewall>
                        <ids>Intrusion prevention</ids>
                        <security>Attack protection</security>
                        <auth>Logins and configuration changes</auth>
                        <system>Everything else</system>
                    </OptionValues>
                </logs>
            </target>
        </siem>
        <!-- what apply changed (original values, to put them back); written by the API only -->
        <applied type="TextField"/>
    </items>
</model>
